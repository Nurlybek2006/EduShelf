@model PersonalLibraryViewModel
@{ ViewData["Title"] = Model.Title; var mine = ViewContext.RouteData.Values["action"]?.ToString() == "Mine"; }
<div class="page-heading"><div><span class="eyebrow">СІЗДІҢ ЖЕКЕ КІТАПХАНАҢЫЗ</span><h1>@Model.Title</h1><p>@Model.Description</p></div>@if (mine) { <a class="btn btn-primary" asp-controller="Resources" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg>Материал қосу</a> }</div>
<div class="catalog-toolbar"><p><strong>@Model.Items.Count</strong> материал</p><div class="view-toggle" role="group" aria-label="Көрсету режимі"><button type="button" class="active" data-view="grid" aria-label="Тор түрінде" aria-pressed="true"><svg class="icon"><use href="#i-grid" /></svg></button><button type="button" data-view="list" aria-label="Тізім түрінде" aria-pressed="false"><svg class="icon"><use href="#i-list" /></svg></button></div></div>
@if (Model.Items.Any()) { <div class="resource-grid" data-resource-grid>@foreach (var item in Model.Items) { <partial name="_ResourceCard" model="item" /> }</div> } else { <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="@(mine ? "#i-folder" : "#i-bookmark")" /></svg></span><h2>@(mine ? "Алғашқы материалыңызды бөлісіңіз" : "Таңдаулыларыңыз осында болады")</h2><p>@(mine ? "Оқу материалын қосып, білім кітапханасын толықтырыңыз." : "Ұнаған материалдағы белгішені басып, оны осы жерге сақтаңыз.")</p><a class="btn btn-primary" asp-controller="Resources" asp-action="@(mine ? "Create" : "Index")">@(mine ? "Материал қосу" : "Каталогты зерттеу")<svg class="icon"><use href="#i-arrow" /></svg></a></div> }
