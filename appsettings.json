{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EduShelf;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5"
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeMb": 20
  },
  "Extraction": {
    "MaxPages": 100,
    "MaxCharacters": 200000,
    "TimeoutSeconds": 30
  },
  "Ai": {
    "Provider": "OpenAI",
    "Endpoint": "https://api.openai.com/v1/",
    "Model": "gpt-4.1-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "EnableEmbeddings": true,
    "RequestTimeoutSeconds": 45,
    "MaxRetries": 2,
    "ChunkCharacters": 12000,
    "MaxChunks": 4,
    "MaxOutputTokens": 1800
  },
  "Worker": {
    "Enabled": true,
    "PollSeconds": 3,
    "LeaseSeconds": 240,
    "MaxAttempts": 3,
    "ProcessingTimeoutSeconds": 180
  },
  "Search": {
    "Mode": "Auto",
    "AllowLikeFallback": true
  },
  "Recommendations": {
    "MaxCandidates": 200,
    "Count": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
