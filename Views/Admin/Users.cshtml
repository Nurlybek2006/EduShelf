@model EduShelf.ViewModels.UsersListViewModel
@{ ViewData["Title"] = "Қолданушылар"; }
<div class="page-heading"><div><span class="eyebrow">ҚОЛЖЕТІМДІЛІКТІ БАСҚАРУ</span><h1>Қолданушылар</h1><p>Жаңа тіркелушілерге білім алушы рөлі автоматты беріледі.</p></div><span class="badge">@Model.TotalCount қолданушы</span></div>
<section class="panel">
    <form asp-action="Users" method="get" class="toolbar">
        <div class="form-field"><label for="user-search">Аты немесе электрондық пошта</label><input id="user-search" name="search" value="@Model.Search" placeholder="Қолданушыны іздеу…" /></div>
        <button class="btn btn-primary" type="submit">Іздеу</button>
        @if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Users" class="btn btn-secondary">Тазалау</a> }
    </form>
    <p class="notice notice-warning">Рөл өзгерген соң қолданушы жүйеге қайта кіруі керек. Соңғы әкімшінің құқығын алып тастауға болмайды.</p>
    @if (Model.Users.Count == 0)
    {
        <div class="empty-state"><h2>Қолданушы табылмады</h2><p>Іздеу сөзін өзгертіп көріңіз.</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th scope="col">Қолданушы</th><th scope="col">Қазіргі рөл</th><th scope="col">Рөлді өзгерту</th></tr></thead>
            <tbody>
            @foreach (var person in Model.Users)
            {
                <tr>
                    <td><strong>@person.FullName</strong><div class="text-muted">@person.Email</div></td>
                    <td>@foreach (var role in person.Roles) { <span class="badge @(role == AppRoles.Admin ? "badge-orange" : "badge-muted")">@(role == AppRoles.Admin ? "Әкімші" : role == AppRoles.Teacher ? "Оқытушы" : "Білім алушы")</span> }</td>
                    <td><form asp-action="ChangeRole" method="post" class="form-actions">
                        <input name="UserId" value="@person.Id" type="hidden" />
                        <select name="Role" aria-label="@person.FullName үшін рөл">
                            <option value="Student" selected="@(person.Roles.Contains(AppRoles.Student))">Білім алушы</option>
                            <option value="Teacher" selected="@(person.Roles.Contains(AppRoles.Teacher))">Оқытушы</option>
                            <option value="Admin" selected="@(person.Roles.Contains(AppRoles.Admin))">Әкімші</option>
                        </select>
                        <button type="submit" class="btn btn-secondary">Сақтау</button>
                    </form></td>
                </tr>
            }
            </tbody>
        </table></div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Қолданушылар беттері">
                @if (Model.Page > 1) { <a asp-action="Users" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-secondary">Алдыңғы</a> }
                <span>@Model.Page / @Model.TotalPages</span>
                @if (Model.Page < Model.TotalPages) { <a asp-action="Users" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-secondary">Келесі</a> }
            </nav>
        }
    }
</section>
