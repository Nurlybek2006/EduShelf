@model HistoryViewModel
@{ ViewData["Title"] = "Менің тарихым"; }
<div class="page-heading"><div><span class="eyebrow">БІЛІМ ЖОЛЫҢЫЗ</span><h1>Менің тарихым</h1><p>Қараған және жүктеген материалдарыңызға оңай оралыңыз.</p></div><span class="step-chip"><svg class="icon"><use href="#i-lock" /></svg>Тек сізге көрінеді</span></div>
@if (Model.Items.Any()) { <section class="panel history-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Материал</th><th>Әрекет</th><th>Уақыты (UTC+5)</th><th><span class="sr-only">Ашу</span></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a class="history-title" asp-controller="Resources" asp-action="Details" asp-route-id="@item.ResourceId"><span class="table-file"><svg class="icon"><use href="#i-file" /></svg></span>@item.Title</a></td><td><span class="badge badge-muted">@item.Action</span></td><td class="text-muted"><time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.AddHours(5).ToString("dd.MM.yyyy · HH:mm")</time></td><td><a class="icon-button" asp-controller="Resources" asp-action="Details" asp-route-id="@item.ResourceId" aria-label="@($"{item.Title} материалын ашу")"><svg class="icon"><use href="#i-arrow" /></svg></a></td></tr> }</tbody></table></div></section> } else { <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="#i-history" /></svg></span><h2>Әр білім жолы алғашқы қадамнан басталады</h2><p>Қараған және жүктеген материалдарыңыз осы жерде көрсетіледі.</p><a class="btn btn-primary" asp-controller="Resources" asp-action="Index">Каталогты ашу <svg class="icon"><use href="#i-arrow" /></svg></a></div> }
