@model AnalyticsViewModel
@{ ViewData["Title"] = "Аналитика"; }
<div class="page-heading"><div><span class="eyebrow">ЕҢБЕГІҢІЗДІҢ НӘТИЖЕСІ</span><h1>Материалдар аналитикасы</h1><p>Оқу материалдарыңыздың қаралымы мен жүктелуі.</p></div><span class="step-chip">Нақты деректер · Барлық уақыт</span></div>
<section class="stat-grid"><div class="stat-card"><span class="stat-icon"><svg class="icon"><use href="#i-folder" /></svg></span><div><strong>@Model.ResourceCount.ToString("N0")</strong><span>Материал</span></div></div><div class="stat-card"><span class="stat-icon orange"><svg class="icon"><use href="#i-eye" /></svg></span><div><strong>@Model.ViewCount.ToString("N0")</strong><span>Жалпы қаралым</span></div></div><div class="stat-card"><span class="stat-icon sand"><svg class="icon"><use href="#i-download" /></svg></span><div><strong>@Model.DownloadCount.ToString("N0")</strong><span>Жалпы жүктеу</span></div></div></section>
<section class="panel"><div class="panel-header"><h2>Материалдар бойынша</h2></div>@if (Model.Items.Any()) { <div class="table-wrap"><table class="data-table"><thead><tr><th>Материал</th><th>Күйі</th><th>Қаралым</th><th>Жүктеу</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a asp-controller="Resources" asp-action="Details" asp-route-id="@item.Id"><strong>@item.Title</strong></a><small class="table-subtitle">@item.SubjectName</small></td><td><span class="badge @(item.Status == ResourceStatus.Published ? "" : "badge-muted")">@(item.Status == ResourceStatus.Published ? "Жарияланған" : item.Status == ResourceStatus.Draft ? "Жоба" : "Архив")</span></td><td>@item.ViewCount</td><td>@item.DownloadCount</td><td><a class="icon-button" asp-controller="Resources" asp-action="Details" asp-route-id="@item.Id" aria-label="Материалды ашу"><svg class="icon"><use href="#i-arrow" /></svg></a></td></tr> }</tbody></table></div> } else { <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="#i-chart" /></svg></span><h3>Алғашқы нәтижелер алда</h3><p>Материал қосылғаннан кейін оның статистикасы осы жерде көрсетіледі.</p><a class="btn btn-primary" asp-controller="Resources" asp-action="Create">Материал қосу</a></div> }</section>
