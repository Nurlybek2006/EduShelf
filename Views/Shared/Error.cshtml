@model ErrorViewModel
@{ ViewData["Title"] = "Сұрауды орындау мүмкін болмады"; }
<section class="empty-state error-page"><span class="empty-icon"><svg class="icon"><use href="#i-info" /></svg></span><h1>Күтпеген қате орын алды</h1><p>Бетті қайта ашып көріңіз. Қате қайталанса, әкімшіге төмендегі сұрау нөмірін жіберіңіз.</p>@if (Model.ShowRequestId) { <p class="field-hint">Сұрау нөмірі: <code>@Model.RequestId</code></p> }<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Басты бетке оралу <svg class="icon"><use href="#i-arrow" /></svg></a></section>
