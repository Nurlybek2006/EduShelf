@model ResourceEditViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Материалды өңдеу" : "Жаңа материал"; }
<a class="back-link" asp-controller="Library" asp-action="Mine"><svg class="icon"><use href="#i-arrow" /></svg>Менің материалдарым</a>
<div class="page-heading"><div><span class="eyebrow">БІЛІММЕН БӨЛІСІҢІЗ</span><h1>@(editing ? "Материалды өңдеу" : "Жаңа материал қосу")</h1><p>Құнды біліміңіз біреудің жаңа қадамына айналсын.</p></div><span class="step-chip">PDF · @Model.MaxFileSizeMb МБ дейін</span></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="edit-layout" data-loading-form>
    <input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div class="edit-main"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <section class="panel"><div class="panel-header"><h2><span class="step-number">01</span>Негізгі ақпарат</h2><span class="text-muted">* Міндетті өрістер</span></div><div class="form-grid"><div class="form-field span-2"><label asp-for="Title">Материал атауы *</label><input asp-for="Title" placeholder="Мысалы: Математикалық талдауға кіріспе" maxlength="200" /><span asp-validation-for="Title"></span></div><div class="form-field span-2"><label asp-for="Description">Сипаттама *</label><textarea asp-for="Description" rows="5" maxlength="4000" placeholder="Материал не туралы? Оқырман қандай білім алады?"></textarea><span asp-validation-for="Description"></span><span class="field-hint">Мақсаты мен негізгі мазмұнын түсінікті сипаттаңыз.</span></div><div class="form-field"><label asp-for="SubjectId">Пән *</label><select asp-for="SubjectId" data-subject-select><option value="">Пәнді таңдаңыз</option>@foreach (var item in Model.Subjects) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="SubjectId"></span></div><div class="form-field"><label asp-for="TopicId">Тақырып</label><select asp-for="TopicId" data-topic-select><option value="">Тақырыпты таңдаңыз</option>@foreach (var item in Model.Topics) { <option value="@item.Id" data-subject="@item.SubjectId">@item.Name</option> }</select><span asp-validation-for="TopicId"></span></div><div class="form-field span-2"><label asp-for="ResourceTypeId">Материал түрі *</label><select asp-for="ResourceTypeId"><option value="">Материал түрін таңдаңыз</option>@foreach (var item in Model.ResourceTypes) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="ResourceTypeId"></span></div><fieldset class="tag-fieldset span-2"><legend>Тегтер</legend><div class="tag-options">@foreach (var tag in Model.Tags) { <label class="tag-option"><input type="checkbox" name="TagIds" value="@tag.Id" checked="@Model.TagIds.Contains(tag.Id)" /><span>#@tag.Name</span></label> }</div><span asp-validation-for="TagIds"></span></fieldset></div></section>
    <section class="panel"><div class="panel-header"><h2><span class="step-number">02</span>Материал файлы</h2></div>@if (editing) { <div class="notice"><svg class="icon"><use href="#i-file" /></svg><span>Ағымдағы файл: <strong>@Model.ExistingFileName</strong>. Жаңа файл таңдалмаса, осы файл сақталады.</span></div> }<div class="upload-area"><span class="upload-icon"><svg class="icon"><use href="#i-upload" /></svg></span><h3>Оқу материалыңызды таңдаңыз</h3><p>PDF форматында, ең көбі @Model.MaxFileSizeMb МБ</p><input asp-for="File" type="file" accept=".pdf,application/pdf" data-max-file-size="@(Model.MaxFileSizeMb * 1024L * 1024L)" aria-label="PDF файлды таңдаңыз" /><p class="selected-file" data-file-name aria-live="polite"></p></div><span asp-validation-for="File"></span></section></div>
    <aside class="edit-side"><section class="panel"><div class="panel-header"><h2><span class="step-number">03</span>Жариялау</h2></div><div class="form-field"><label asp-for="Status">Материал күйі</label><select asp-for="Status"><option value="Draft">Жоба</option><option value="Published">Жарияланған</option><option value="Archived">Архив</option></select><span asp-validation-for="Status"></span><p class="field-hint">Жобалар мен архивтегі материалдар тек сізге және әкімшіге көрінеді.</p></div><div class="form-field"><label asp-for="AccessLevel">Қолжетімділік</label><select asp-for="AccessLevel"><option value="Public">Барлық оқырмандарға</option><option value="Authenticated">Тіркелген оқырмандарға</option></select><span asp-validation-for="AccessLevel"></span></div><div class="form-actions vertical"><button class="btn btn-primary btn-block" type="submit" data-loading-text="Сақталуда..."><svg class="icon"><use href="#i-check" /></svg>@(editing ? "Өзгерістерді сақтау" : "Материалды сақтау")</button><a class="btn btn-ghost btn-block" asp-controller="Library" asp-action="Mine">Болдырмау</a></div></section><div class="edit-tip"><svg class="icon"><use href="#i-info" /></svg><h3>Сапалы материал — ортақ құндылық</h3><p>Атауды нақты жазыңыз, сәйкес пәнді таңдаңыз және бөлісуге құқығыңыз бар файлды жүктеңіз.</p></div></aside>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
