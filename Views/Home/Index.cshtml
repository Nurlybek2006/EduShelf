@model HomeViewModel
@{ ViewData["Title"] = "Басты бет"; }
<div class="welcome-line"><div><span class="eyebrow">ІЗДЕН. ҮЙРЕН. БӨЛІС.</span><h1>Білімге толы күніңіз басталсын <span class="greeting-sun">✳</span></h1><p>Қажетті материалды тауып, жаңа мүмкіндіктерге жол ашыңыз.</p></div><span class="date-chip"><svg class="icon"><use href="#i-book" /></svg>Сіздің білім кеңістігіңіз</span></div>
<section class="hero">
    <div class="hero-content"><span class="hero-kicker"><span></span> БӘРІ БІР КІТАПХАНАДА</span><h2>Үлкен мақсаттар.<br />Кішкентай <em>қадамдар.</em></h2><p>Дәрістер, оқу құралдары және пайдалы материалдар.<br class="desktop-only" /> Білім жолындағы сенімді серігіңіз — EduShelf.</p><a class="btn btn-orange" asp-controller="Resources" asp-action="Index">Материалдарды зерттеу <svg class="icon"><use href="#i-arrow" /></svg></a></div>
    <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="art-plus art-plus-one">+</span><span class="art-plus art-plus-two">✳</span><div class="floating-note"><svg class="icon"><use href="#i-check" /></svg><span>Күн сайын<br /><strong>жаңа білім</strong></span></div><div class="book-stack"><div class="art-book book-back"><span>БІЛІМ</span></div><div class="art-book book-mid"><span>ӨСУ</span></div><div class="art-book book-front"><svg class="icon"><use href="#i-book" /></svg><span>ЖАҢА<br />МҮМКІНДІКТЕР</span><i></i></div></div><span class="art-caption">Білім — ең құнды инвестиция.</span></div>
</section>
<section class="stat-grid" aria-label="Кітапхана статистикасы"><div class="stat-card"><span class="stat-icon"><svg class="icon"><use href="#i-folder" /></svg></span><div><strong>@Model.ResourceCount.ToString("N0")</strong><span>Оқу материалы</span></div><span class="stat-decoration">↗</span></div><div class="stat-card"><span class="stat-icon orange"><svg class="icon"><use href="#i-book" /></svg></span><div><strong>@Model.SubjectCount.ToString("N0")</strong><span>Білім беру пәні</span></div><span class="stat-decoration">↗</span></div><div class="stat-card"><span class="stat-icon sand"><svg class="icon"><use href="#i-download" /></svg></span><div><strong>@Model.DownloadCount.ToString("N0")</strong><span>Материал жүктелді</span></div><span class="stat-decoration">↗</span></div></section>
<section class="content-section"><div class="section-heading"><div><span class="eyebrow">БІЛІМ КӨКЖИЕГІ</span><h2>Қай бағыт сізге жақын?</h2></div><a class="text-link" asp-controller="Resources" asp-action="Index">Барлық пәндер <svg class="icon"><use href="#i-arrow" /></svg></a></div><div class="subject-grid">@foreach (var subject in Model.Subjects.Take(6)) { <a class="subject-card" asp-controller="Resources" asp-action="Index" asp-route-SubjectId="@subject.Id"><span class="subject-icon"><svg class="icon"><use href="#i-book" /></svg></span><strong>@subject.Name</strong><svg class="icon subject-arrow"><use href="#i-chevron" /></svg></a> }</div>@if (!Model.Subjects.Any()) { <div class="empty-inline">Пәндер әлі қосылған жоқ. Жаңа бағыттар осы жерде пайда болады.</div> }</section>
<section class="content-section"><div class="section-heading"><div><span class="eyebrow">КІТАПХАНАДАҒЫ ЖАҢАЛЫҚТАР</span><h2>Соңғы қосылған материалдар</h2></div><a class="text-link" asp-controller="Resources" asp-action="Index">Барлығын көру <svg class="icon"><use href="#i-arrow" /></svg></a></div><div class="resource-grid">@foreach (var resource in Model.Latest) { <partial name="_ResourceCard" model="resource" /> }</div>@if (!Model.Latest.Any()) { <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="#i-folder" /></svg></span><h3>Кітапхананың алғашқы беті</h3><p>Жарияланған материалдар осы жерде көрсетіледі.</p>@if (User.IsInRole("Teacher") || User.IsInRole("Admin")) { <a class="btn btn-primary" asp-controller="Resources" asp-action="Create">Алғашқы материалды қосу</a> }</div> }</section>
@if (Model.Popular.Any()) { <section class="content-section"><div class="section-heading"><div><span class="eyebrow">ОҚЫРМАНДАР ТАҢДАУЫ</span><h2>Көп қаралған материалдар</h2></div><a class="text-link" asp-controller="Resources" asp-action="Index" asp-route-Sort="popular">Танымал материалдар <svg class="icon"><use href="#i-arrow" /></svg></a></div><div class="resource-grid">@foreach (var resource in Model.Popular) { <partial name="_ResourceCard" model="resource" /> }</div></section> }
<section class="bottom-banner"><span class="banner-icon"><svg class="icon"><use href="#i-spark" /></svg></span><div><h3>Бірге үйрену — әрқашан тиімдірек.</h3><p>Пайдалы материалдарды сақтап, өз білім жолыңызды қалыптастырыңыз.</p></div><a class="btn btn-secondary" asp-controller="Library" asp-action="Favorites">Менің таңдаулыларым <svg class="icon"><use href="#i-arrow" /></svg></a></section>
