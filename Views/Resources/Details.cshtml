@model ResourceDetailsViewModel
@{
    var resource = Model.Resource;
    ViewData["Title"] = resource.Title;
    var returnUrl = Url.Action("Details", "Resources", new { id = resource.Id });
    var size = resource.FileSize >= 1048576 ? $"{resource.FileSize / 1048576.0:0.0} МБ" : $"{resource.FileSize / 1024.0:0} КБ";
}
<a class="back-link" asp-action="Index"><svg class="icon"><use href="#i-arrow" /></svg>Каталогқа оралу</a>
<div class="detail-heading"><div class="detail-badges"><span class="badge">@resource.Subject.Name</span><span class="badge badge-muted">@resource.ResourceType.Name</span>@if (resource.Status != ResourceStatus.Published) { <span class="badge badge-orange">@(resource.Status == ResourceStatus.Draft ? "Жоба" : "Архив")</span> }@if (resource.AccessLevel == AccessLevel.Authenticated) { <span class="badge badge-muted"><svg class="icon"><use href="#i-lock" /></svg>Тіркелген оқырмандарға</span> }</div><h1>@resource.Title</h1><div class="detail-byline"><span class="mini-avatar">@(string.IsNullOrWhiteSpace(resource.Owner.FullName) ? "E" : resource.Owner.FullName[..1])</span><strong>@resource.Owner.FullName</strong><span>·</span><time datetime="@resource.CreatedAtUtc.ToString("O")">@resource.CreatedAtUtc.AddHours(5).ToString("dd.MM.yyyy")</time><span>·</span><span><svg class="icon"><use href="#i-eye" /></svg>@Model.ViewCount қаралым</span></div></div>
<div class="detail-layout"><div class="detail-main"><section class="panel"><div class="panel-header"><h2>Материал туралы</h2><span class="file-type-label">PDF</span></div><p class="detail-description">@resource.Description</p>@if (resource.Topic != null) { <div class="topic-line"><span class="text-muted">Тақырып</span><strong>@resource.Topic.Name</strong></div> }@if (resource.ResourceTags.Any()) { <div class="tag-list">@foreach (var item in resource.ResourceTags) { <a class="tag" asp-action="Index" asp-route-Search="@item.Tag.Name">#@item.Tag.Name</a> }</div> }</section>
<section class="preview-panel panel"><div class="panel-header"><h2><svg class="icon"><use href="#i-file" /></svg>Алдын ала қарау</h2>@if (Model.FileExists) { <a class="text-link" asp-action="Preview" asp-route-id="@resource.Id" target="_blank" rel="noopener">Жеке терезеде ашу ↗</a> }</div>@if (Model.FileExists) { <iframe class="pdf-preview" src="@Url.Action("Preview", new { id = resource.Id })#toolbar=1" title="@resource.Title — PDF алдын ала қарау" loading="lazy"></iframe><p class="field-hint preview-hint">PDF көрінбесе, «Жеке терезеде ашу» сілтемесін немесе жүктеу батырмасын пайдаланыңыз.</p> } else { <div class="empty-state"><span class="empty-icon"><svg class="icon"><use href="#i-file" /></svg></span><h3>Файл қолжетімсіз</h3><p>Материалдың файлы табылмады. Авторға немесе әкімшіге хабарласыңыз.</p></div> }</section>
<section class="panel analysis-panel"><span class="stat-icon orange"><svg class="icon"><use href="#i-spark" /></svg></span><div><h2>AI талдауы</h2><span class="badge badge-muted">Талдау орындалмаған</span><p>Материалды автоматты талдау келесі кезеңде қосылады.</p></div></section></div>
<aside class="detail-side"><section class="panel download-panel"><span class="download-file-icon"><svg class="icon"><use href="#i-file" /></svg></span><h2>Оқуға дайынсыз ба?</h2><p>Материалды жүктеп алып,<br />өзіңізге ыңғайлы уақытта оқыңыз.</p><div class="file-details"><span class="file-name">@resource.OriginalFileName</span><span>PDF · @size</span></div>@if (Model.FileExists) { <form asp-action="Download" asp-route-id="@resource.Id" method="post" data-download-form><button class="btn btn-primary btn-block"><svg class="icon"><use href="#i-download" /></svg>Материалды жүктеу</button></form> } else { <span class="btn btn-secondary btn-block disabled">Файл қолжетімсіз</span> }@if (User.Identity?.IsAuthenticated == true) { <form asp-controller="Library" asp-action="ToggleFavorite" method="post"><input type="hidden" name="id" value="@resource.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button class="btn btn-secondary btn-block @(Model.IsFavorite ? "is-favorite" : "")"><svg class="icon"><use href="#i-bookmark" /></svg>@(Model.IsFavorite ? "Таңдаулыдан алып тастау" : "Таңдаулыға сақтау")</button></form> } else { <a class="btn btn-secondary btn-block" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"><svg class="icon"><use href="#i-bookmark" /></svg>Таңдаулыға сақтау</a> }<div class="download-count"><svg class="icon"><use href="#i-download" /></svg>@Model.DownloadCount рет жүктелді</div></section>
@if (Model.CanEdit) { <section class="panel manage-panel"><h3>Материалды басқару</h3><a class="btn btn-secondary btn-block" asp-action="Edit" asp-route-id="@resource.Id"><svg class="icon"><use href="#i-edit" /></svg>Материалды өңдеу</a><form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@resource.Id" /><input type="hidden" name="status" value="@(resource.Status == ResourceStatus.Published ? ResourceStatus.Archived : ResourceStatus.Published)" /><button class="btn btn-ghost btn-block"><svg class="icon"><use href="@(resource.Status == ResourceStatus.Published ? "#i-archive" : "#i-upload")" /></svg>@(resource.Status == ResourceStatus.Published ? "Архивке жіберу" : "Жариялау")</button></form></section> }
<div class="detail-tip"><svg class="icon"><use href="#i-shield" /></svg><p>Білімді жауапкершілікпен қолданыңыз. Автордың еңбегін құрметтеңіз.</p></div></aside></div>
